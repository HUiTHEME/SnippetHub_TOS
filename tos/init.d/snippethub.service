[Unit]
Description=SnippetHub - private snippet and note vault
Documentation=https://github.com/HUiTHEME/SnippetHub_TOS
# ⚠️ 开机自启依赖这两行，缺一不可（实测：不加就是重启后应用不启动）：
#
# 1) 应用装在 /Volume1/@apps 下，而 /Volume1 是 TOS 自己的 tnas-mntdata.service
#    挂载的，比 multi-user.target 早不了多少。卷没挂上时，ReadWritePaths 里的
#    data 目录不存在，systemd 会在「建立挂载命名空间」这一步直接失败
#    （226/NAMESPACE），服务起不来。
# 2) RequiresMountsFor 单独用它不够：unit 是在开机很早的时候被加载的，
#    那时卷还没挂，systemd 解析路径会当成「在根文件系统上」，于是不生成
#    挂载依赖。真正起作用的是下面这条显式的 After/Wants。
RequiresMountsFor=/usr/local/snippethub
Wants=tnas-mntdata.service
After=network.target local-fs.target tnas-mntdata.service
# 崩溃循环保护：60 秒内最多拉起 5 次，超了 systemd 会停下并标记失败。
# （Restart= / RestartSec= 按平台规范不在这里配置，重启策略由 TOS 管理。）
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=snippethub
# Group 显式写 allusers：TOS 建应用用户时主组就是 allusers，并不存在同名的
# snippethub 组，写 Group=snippethub 会让 systemd 在 ExecStart 之前就以
# 216/GROUP 失败；换成别的组又会丢掉 allusers 成员身份，共享文件夹就读不到了。
Group=allusers
WorkingDirectory=/usr/local/snippethub
EnvironmentFile=-/usr/local/snippethub/snippethub.env
ExecStart=/usr/local/snippethub/bin/snippethub -data /usr/local/snippethub/data -socket /var/api/snippethub.sock
# 启动前用 root 做三件事（前面加 "+" 表示脱离 User= 以完整权限执行）：
#   1. /var/api 可能不存在，先建出来；
#   2. 它的权限必须是 1777：TOS 开机重建 /tmp/api 后可能是 755，
#      应用用户在里面既建不了也删不掉自己的 socket，会 bind: permission denied；
#   3. 上一轮异常退出可能留下 socket，先删掉，否则 bind: address already in use。
ExecStartPre=+/bin/sh -c "mkdir -p /var/api; chmod 1777 /var/api; rm -f /var/api/snippethub.sock"
ExecStopPost=-/bin/rm -f /var/api/snippethub.sock
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# PrivateTmp 不能用：/var/api 在 TOS 上是 /tmp/api 的软链，
# 独立的 /tmp 命名空间会让服务以 226/NAMESPACE 起不来。
# ProtectSystem=strict 下 /usr/local 是只读的，数据目录、日志目录和
# /var/api 必须显式放开（应用只在 socket 上监听，不绑任何 TCP 端口）。
ReadWritePaths=/usr/local/snippethub/data /usr/local/snippethub/logs /var/api
LimitNOFILE=65536
LimitNPROC=512

[Install]
WantedBy=multi-user.target
