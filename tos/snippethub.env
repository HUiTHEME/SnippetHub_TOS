# systemd EnvironmentFile —— 只放运行期需要的环境变量。
# 数据目录默认在 /usr/local/snippethub/data（物理位置 /Volume<N>/@apps/snippethub/data），
# 升级与重装都不会动它；用户也可以在应用「设置 → 数据备份 → 数据目录」里
# 换成任意共享文件夹，切换结果记在数据目录的 location 文件里。
PATH=/usr/local/snippethub/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
CONFIG_DATA=/usr/local/snippethub/data
DATA_LOG=/usr/local/snippethub/logs
TZ=Asia/Shanghai
