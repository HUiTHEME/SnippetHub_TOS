[Unit]
Description=SnippetHub - private snippet and note vault
Documentation=https://github.com/HUiTHEME/SnippetHub_TOS
After=network.target
StartLimitBurst=5
StartLimitIntervalSec=60

[Service]
Type=simple
User=snippethub
# Group= 故意不写：TOS 7 建应用用户时主组是 allusers，并不存在同名的
# snippethub 组，写了会让 systemd 在 ExecStart 之前就以 216/GROUP 失败；
# 换成别的组又会丢掉 allusers 成员身份，共享文件夹的读权限就没了。
WorkingDirectory=/usr/local/snippethub
EnvironmentFile=-/usr/local/snippethub/snippethub.env
ExecStart=/usr/local/snippethub/bin/snippethub -data /usr/local/snippethub/data -socket /var/api/snippethub.sock
# 前面加 "-" 是允许删除失败：/var/api 是 1777 共享目录，
# 万一 socket 路径被别的用户的文件占住，rm 会 EPERM，
# 不带 "-" 的话 systemd 会把一次正常停机记成「停用失败」。
ExecStopPost=-/bin/rm -f /var/api/snippethub.sock
TimeoutStartSec=30
TimeoutStopSec=10
KillMode=control-group
KillSignal=SIGTERM
SendSIGKILL=yes

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateDevices=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
# PrivateTmp 不能用：/var/api 在 TOS 上是 /tmp/api 的软链，
# 独立的 /tmp 命名空间会让它变成 226/NAMESPACE 起不来。
# ProtectSystem=strict 下 /usr/local/snippethub 是只读的，
# 所以 data/logs 和 /var/api 必须显式放开；- 前缀表示该卷不存在就跳过，
# 因为应用支持把数据目录切到任意 Volume 下的共享文件夹。
ReadWritePaths=/usr/local/snippethub/data /usr/local/snippethub/logs /var/api -/Volume1 -/Volume2 -/Volume3 -/Volume4 -/Volume5 -/Volume6
LimitNOFILE=65536
LimitNPROC=512

# 进程异常退出时自己拉起来；正常停机的退出码是 0，on-failure 不会触发重启，
# 所以 App Center 的「停用」依然能把服务停住。
Restart=on-failure
RestartSec=10

[Install]
WantedBy=multi-user.target
