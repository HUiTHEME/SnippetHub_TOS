[zh-cn]
name = "片段HUB"
auth = "疯狂的大叔"
descript = "私人内容仓库：把零散的代码片段、踩坑笔记与生活碎片存进来。支持 Markdown 语法、文件夹与标签双分类、附件上传、亮暗主题、整库备份与导入，所有数据只保存在你自己的 NAS 上。"
important = "首次打开需要设置访问密码，请记好恢复码；数据默认保存在 /usr/local/snippethub/data。"

[zh-hk]
name = "片段HUB"
auth = "瘋狂的大叔"
descript = "私人內容倉庫：把零散的程式碼片段、踩坑筆記與生活碎片存進來。支援 Markdown 語法、資料夾與標籤雙分類、附件上傳、亮暗主題、整庫備份與匯入，所有資料只保存在你自己的 NAS 上。"
important = "首次開啟需要設定存取密碼，請記好復原碼；資料預設保存在 /usr/local/snippethub/data。"

[en-us]
name = "SnippetHub"
auth = "疯狂的大叔"
descript = "A private vault for your code snippets, tutorials and notes. Markdown with syntax highlighting, folders and tags, attachments, light and dark themes, whole-vault backup and import. Everything stays on your own NAS."
important = "You will set an access password on first launch - keep the recovery code safe. Data lives in /usr/local/snippethub/data."

[ko-kr]
name = "SnippetHub"
auth = "疯狂的大叔"
descript = "코드 스니펫, 튜토리얼, 메모를 모아 두는 개인 보관소입니다. Markdown과 구문 강조, 폴더와 태그, 첨부 파일, 라이트/다크 테마, 전체 백업 및 가져오기를 지원하며 모든 데이터는 사용자의 NAS에만 저장됩니다."
important = "처음 실행할 때 접근 비밀번호를 설정합니다. 복구 코드를 안전하게 보관하세요. 데이터는 기본적으로 /usr/local/snippethub/data에 저장됩니다."

[ja-jp]
name = "SnippetHub"
auth = "疯狂的大叔"
descript = "コードスニペット、チュートリアル、メモをまとめる個人用の保管庫です。Markdown とシンタックスハイライト、フォルダーとタグ、添付ファイル、ライト／ダークテーマ、一括バックアップと復元に対応。データはすべてご自身の NAS に保存されます。"
important = "初回起動時にアクセスパスワードを設定します。復元コードは大切に保管してください。データは既定で /usr/local/snippethub/data に保存されます。"

[de-de]
