#!/bin/bash
# 片段HUB SnippetHub —— 安装后（以及每次升级后）执行
#
# $1 = configure（安装/升级都会是这个）
# $2 = 升级前的版本号，全新安装时为空
set -e

APPID="snippethub"
APP="/usr/local/${APPID}"
UNIT_SRC="${APP}/init.d/${APPID}.service"
UNIT_DST="/etc/systemd/system/${APPID}.service"

# TOS 的 App Center 安装时会按 config.ini 的 user 字段自动建用户，
# 但手工 dpkg -i 安装时不会 —— 这里做一次幂等兜底，两边都能跑。
# 主组跟随 TOS 的约定用 allusers，否则共享文件夹读不到。
if ! id "${APPID}" >/dev/null 2>&1; then
    if getent group allusers >/dev/null 2>&1; then
        useradd -r -s /usr/sbin/nologin -d "${APP}" -g allusers "${APPID}" 2>/dev/null || true
    else
        useradd -r -s /usr/sbin/nologin -d "${APP}" "${APPID}" 2>/dev/null || true
    fi
fi

# 运行期目录：日志放在安装目录（卸载时一起清掉），数据放共享文件夹。
mkdir -p "${APP}/logs" /var/api

# 数据目录：/VolumeN/snippethub（共享文件夹）。
# 从应用中心安装时平台会按 config.ini 的 share_folders 建好并授权；
# 用 dpkg 侧载时平台不管，这里兜底建一个，属主给应用用户。
for v in 1 2 3 4 5 6 7 8 9; do
    [ -d "/Volume${v}" ] || continue
    SHARE="/Volume${v}/snippethub"
    mkdir -p "${SHARE}" 2>/dev/null || continue
    chown "${APPID}:allusers" "${SHARE}" 2>/dev/null || true
    chmod 750 "${SHARE}" 2>/dev/null || true
    break
done

# 属主给应用用户、属组给 allusers，和平台创建应用用户时保持一致。
# 日志目录同样收紧权限：目录 750、内容 640，别人读不到。
chown -R "${APPID}:allusers" "${APP}/logs" 2>/dev/null || true
chmod 750 "${APP}/logs" 2>/dev/null || true
if [ -d "${APP}/data" ]; then
    chown -R "${APPID}:allusers" "${APP}/data" 2>/dev/null || true
    chmod 750 "${APP}/data" 2>/dev/null || true
fi

# 前端页面：App Center 安装时平台会解压 webui.bz2，手工安装不会，这里补一次。
# 解压出来是 webui/ 目录（内部含 index.html），与平台 nginx 的站点根保持一致。
if [ -f "${APP}/webui.bz2" ]; then
    tar -xjf "${APP}/webui.bz2" -C "${APP}" 2>/dev/null || true
    # 权限最小化：原来的 a+rX 让所有人都能读页面文件，现在收成
    # root:allusers 750 —— 平台 nginx 以 root（或 allusers 组）运行，读得到，
    # 其它普通用户读不到。
    chown -R root:allusers "${APP}/webui" 2>/dev/null || true
    chmod -R 750 "${APP}/webui" 2>/dev/null || true
fi

# TOS 要求 unit 文件放在应用目录 /usr/local/<appid>/init.d/ 下，但 systemd
# 只扫 /etc/systemd/system，所以要往那边放一份。
#
# ⚠️ 必须用「复制」而不是「符号链接」：应用目录在 /Volume1/@apps 上，
# 开机早期卷还没挂载，软链是断的，systemd 会把这个单元判成 not-found
# 直接跳过（日志里是 Failed to open /etc/systemd/system/<appid>.service:
# No such file or directory），结果就是「重启后应用不会自己启动」。
# 复制到根文件系统后，开机就在；unit 里的 RequiresMountsFor 再保证等挂载完成。
rm -f "${UNIT_DST}"
cp "${UNIT_SRC}" "${UNIT_DST}"
chmod 644 "${UNIT_DST}"

case "$1" in
    configure)
        if [ -n "$2" ]; then
            echo "snippethub: upgrading from ${2}"
            # 升级不动数据，只校正一次归属
            chown -R "${APPID}:allusers" "${APP}/logs" 2>/dev/null || true
            [ -d "${APP}/data" ] && chown -R "${APPID}:allusers" "${APP}/data" 2>/dev/null || true
        fi
        systemctl daemon-reload 2>/dev/null || true
        systemctl enable "${APPID}.service" 2>/dev/null || true
        # 升级后必须重启才用上新二进制；全新安装时 restart 等价于 start
        systemctl restart "${APPID}.service" 2>/dev/null || true
        ;;
esac

exit 0
