#!/bin/bash
# 片段HUB SnippetHub —— 卸载后执行
#
# 数据不在安装目录里：1.0.7 起数据放在共享文件夹 /VolumeN/snippethub。
# 卸载只清「程序自己生成的运行时产物」，用户数据原样留在共享夹里，
# 所以这里可以放心清干净，不会像早期版本那样「重装一次删一次库」。
#
# 从老版本（≤1.0.6，数据还在 /usr/local/<appid>/data）卸载时，
# 只有在共享夹里确实已经有一份完整数据（db.json）时才删旧目录。
set -e

APPID="snippethub"
APP="/usr/local/${APPID}"
UNIT_DST="/etc/systemd/system/${APPID}.service"

# 先摘掉 systemd 的注册，否则以后同名的旧 unit 会一直挂在列表里
rm -f "${UNIT_DST}"

# 清掉可重建的运行时产物：页面、日志、残留 socket
rm -rf "${APP}/webui" "${APP}/logs"
rm -f /var/api/"${APPID}".sock

# 老版本遗留的数据目录：确认共享夹里有 db.json 才删
if [ -d "${APP}/data" ]; then
    for v in 1 2 3 4 5 6 7 8 9; do
        if [ -f "/Volume${v}/snippethub/db.json" ]; then
            rm -rf "${APP}/data"
            break
        fi
    done
fi

# 安装目录空了就一起删掉，别留下空壳
rmdir "${APP}" 2>/dev/null || true

systemctl daemon-reload 2>/dev/null || true

exit 0
